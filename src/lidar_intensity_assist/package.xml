<?xml version="1.0"?>
<package format="3">
  <name>lidar_intensity_assist</name>
  <version>0.1.0</version>
  <description>ROS 2 intensity-assisted LiDAR odometry front end.</description>
  <maintainer email="just_like_wind1@163.com">Yu Li</maintainer>
  <license>BSD</license>
  <url type="website">https://gitee.com/SLAMaxLAB/lidar_intensity_assist</url>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <build_depend>libopencv-dev</build_depend>
  <build_depend>libceres-dev</build_depend>
  <build_depend>libpcl-all-dev</build_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
